# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
git.txt
/out/

# production
/build
/features/casino/components/chess/.build/build/
/features/casino/components/chess/*/dist/
# Lichess runtime bundles are deployable assets, not disposable local output.
# Keep source maps and the Ark puzzle bundle ignored; CI builds the latter.
/public/compiled/*.map
/public/compiled/ark-puzzle.js
/public/css/*.map
/public/css/ark-puzzle.css
/public/hashed/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent tooling and vendored skills (keep only the tracked engineering standards)
.agents/
.worktrees/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/wsws-engineering-standards/

# Design handoff reference bundles (not shipped)
design_handoff_*/

# One-shot helper scripts handed to the developer, never part of the tree.
# Root level only, so scripts/ is unaffected.
/*.sh

# Screen recordings shared for debugging, never part of the tree.
*.mov

# ESLint cache, kept by CI between runs
.eslintcache

# The legacy directory is hashed and safe, but 5MB per revision is a real
# cost in git history, and production reads it from LEGACY_DIRECTORY_URL.
# Commit it only if you intend the bundled mode, which needs it in the repo.
config/legacy-directory.csv

# Local CCTP test harness (scratch, not for commit)
cctp-run.mjs
cctp-hypercore-run.mjs
cctp-arb-to-base.mjs
