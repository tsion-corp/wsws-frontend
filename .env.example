NEXT_PUBLIC_PRIVY_APP_ID=

PRIVY_APP_SECRET=

# Server-only country lookup used by local Chess tournament joins. Production
# prefers trusted edge country headers when they are present.
IPINFO_TOKEN=

# Public, read-only origin for immutable Ark Chess engines, voice models, and
# media. Upload credentials below are only needed by chess:assets:publish and
# must remain server-side.
NEXT_PUBLIC_CHESS_ASSET_BASE_URL=https://pub-669f5226f445418d8b07f013b8de572d.r2.dev
R2_PUBLIC_URL=https://pub-669f5226f445418d8b07f013b8de572d.r2.dev
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Required by publish/audit after migration; point it at a checkout that still
# contains the complete pre-migration public asset tree.
CHESS_ASSET_SOURCE_ROOT=

# Alchemy keys, comma-separated, in the order they are tried. Every Alchemy
# call (prices, reads that fall through from ZeroDev, the bundler and the
# paymaster) walks the list until a key can serve it; a key that answers
# capacity, rate limit or auth is skipped for a cooldown. See
# ADR-2026-09-07-alchemy-key-pool.
ALCHEMY_API_KEY=
# Deprecated: appended after the list above. Move the key into the list.
ALCHEMY_API_KEY_FALLBACK=
# Gas Manager policies, comma-separated, INDEX-ALIGNED with ALCHEMY_API_KEY: a
# policy belongs to the Alchemy app that created it, so the policy at index N
# is only ever sent with the key at index N. Leave a slot blank (",,") for a
# key that has no policy; it then reads and prices but never sponsors.
ALCHEMY_GAS_POLICY_ID=
# Same alignment, for Polygon. Blank slots skip that index for Polygon.
ALCHEMY_POLYGON_GAS_POLICY_ID=
# Server-only Solana mainnet RPC pool. The fallback is tried when the primary
# Helius project is throttled or unavailable. Never expose these as NEXT_PUBLIC_*.
HELIUS_API_KEY=
HELIUS_API_KEY_FALLBACK=
# Optional provider-neutral Solana RPC override. A legacy Alchemy URL remains
# available as fallback behind Helius; any other explicit provider stays first.
SOLANA_RPC_URL=

# Server-only ZeroDev project id. One project derives the EVM read RPC URL for
# every supported chain. Bundler/paymaster submission remains on Alchemy. Keep
# this out of NEXT_PUBLIC_* variables.
ZERODEV_PROJECT_ID=

DEXTOPUS_API_KEY=

DEXTOPUS_WITHDRAW_API_KEY=
# Everything else that moves money through Dextopus (spot buys and sells, the
# buy catalog, gas top-ups, the casino fund sheet, prediction settlement) is a
# Optional dedicated third integration. When omitted, trade routes fall back
# to DEXTOPUS_API_KEY for compatibility with existing environments.
DEXTOPUS_TRADE_API_KEY=

LIFI_API_KEY=

POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=
# Builder code for on-chain trade attribution (public, embedded in signed orders).
NEXT_PUBLIC_POLYMARKET_BUILDER_CODE=

NEXT_PUBLIC_PREDICTION_CONTRACT_ADDRESS=

NEXT_PUBLIC_VAULT_WS_URL=wss://ws.tsionark.com/
NEXT_PUBLIC_VAULT_CONTRACT_ADDRESS=0x103db9Ac546297371499AC571880065A59B8Ac38

NEXT_PUBLIC_PREDICTION_CONTRACT_ADDRESS=0x09F05Bdfb3cFA9125f253b8E3d7814cC5Beca3D0

# Mixpanel project token (project 4051122, US data residency). Public by
# design: it can only write events. One token for every environment; each event
# carries `environment` (production, preview or development), and reports on
# real users filter on production. The browser sends through our own
# /api/relay, which forwards to api.mixpanel.com and refuses any other
# project's token. Unset means analytics is off, which is what local
# development should do. See lib/analytics/relay.ts.
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Microsoft Clarity project id. Unset means lib/analytics/clarity.ts is a
# no-op, so no session is recorded.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# The launch gate (lib/launch-gate.ts). Before this moment the landing page
# shows a countdown and every other route redirects home; from it the site is
# live, no redeploy needed. ISO with offset. Unset means no scheduled launch.
NEXT_PUBLIC_LAUNCH_AT=2026-08-16T20:00:00+01:00

# Market Square — the ecosystem social surface. Unset links to the production
# square, https://square.tsionark.com; an empty value hides the nav entry rather
# than rendering a link that goes nowhere.
NEXT_PUBLIC_MARKET_SQUARE_URL=
# Market Square is shown by default. Exactly "false" closes it in that
# environment without a code change; anything else, including unset, is on.
# Inlined at build, so a change means a redeploy. See lib/market-square.ts.
NEXT_PUBLIC_MARKET_SQUARE_LIVE=
# Live Support AI & Chatwoot Proxy Endpoint (default: https://support.tsionark.com)
SUPPORT_CHAT_API_URL=https://support.tsionark.com

# Watchtower: error tracking, logs and performance (watchtower-logger.vercel.app).
# The DSN is the project key and project id as one Sentry-format URL:
#   https://<project key>@watchtower-logger.vercel.app/<project id>
# Public by design and write-only: it can post an event and read nothing back,
# so it ships in the browser bundle. Unset disables reporting entirely, which
# is what local development should do. See lib/analytics/watchtower.ts.
NEXT_PUBLIC_WATCHTOWER_DSN=
# Source map upload at build time. CI only. WATCHTOWER_AUTH_TOKEN is
# Watchtower's org token (wtt_...), a real credential: it must never be
# NEXT_PUBLIC_ and must never reach the client bundle. Without it the build
# still succeeds and simply ships no maps.
#
# Deliberately NOT named SENTRY_*. The bundler plugin reads those from the
# environment by itself, so a stray SENTRY_AUTH_TOKEN left over from any other
# account silently switches uploading back on and points it at the wrong host.
# That is what hung the first build here.
WATCHTOWER_ORG=
WATCHTOWER_PROJECT=
WATCHTOWER_AUTH_TOKEN=
# Source map upload runs when all three of WATCHTOWER_ORG, WATCHTOWER_PROJECT
# and WATCHTOWER_AUTH_TOKEN are set, which in practice means CI. There is no
# separate on/off flag: the credential is the switch. A laptop or preview
# without a token still builds and simply ships no maps.
#
# Without maps every issue is minified frames (chunk-xxx.js:1:12345) instead of
# original file and line, so this is worth having wired up in CI.

# Memecoin discovery on Solana. Off unless exactly "1". While off, the meme
# desk, grid, phone tab, search, trending and the dashboard brief list Base
# coins only, in both the Curated and All views; Solana trading code is
# unaffected. Switch on only once ops confirm a funding SLA for the Solana gas
# sponsor wallet (ADR-2026-09-14-memecoins-trade-contract, slice 4). Inlined at
# build time, so a change needs a rebuild.
NEXT_PUBLIC_MEME_SOLANA_DISCOVERY=

# ── Legacy directory (Privy → Decane migration) ──────────────────────────────
# Who held a Privy account, as sha256(lowercased email),evm,solana. Decides
# whether the balance card offers "Update Balance"; the balance itself is read
# live, never from here. Build the file with:
#     pnpm legacy:hash privy-export.csv > legacy-directory.csv
#
# Point this at any CSV — a published Google Sheet, S3, a gist. Unset, the
# server reads config/legacy-directory.csv from the bundle instead.
# NOTE: use the sheet's CSV export URL, not its /edit link. The /edit link
# answers 200 with HTML, which is treated as unreadable rather than as an
# empty membership — but it means the directory silently never loads.
# LEGACY_DIRECTORY_URL=https://docs.google.com/spreadsheets/d/<id>/export?format=csv&gid=<gid>
#
# How long a fetched copy is reused, ms. Nothing fetches on a schedule: the
# first lookup does, and a stale copy is served while a new one is fetched, so
# a short window costs requests and never latency. 0 = every lookup downloads
# the file and waits. Default 60000.
# LEGACY_DIRECTORY_TTL_MS=60000
# CoinGecko Demo API key (free: 30 calls/min). Without it requests fall to the
# throttled public tier and charts intermittently fail to load.
COINGECKO_API_KEY=
